# Anthropic Console API key (preferred for apps / shared use)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Claude Code OAuth (Pro/Max/Team/Enterprise) from `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Optional bearer token for a gateway/proxy
# ANTHROPIC_AUTH_TOKEN=

# Optional API host (LLM gateway/proxy). Also read from Claude settings env.ANTHROPIC_BASE_URL
# ANTHROPIC_BASE_URL=https://llm-gateway.example.com

# Optional: cache lifetime (ms) for Claude settings apiKeyHelper output (default 300000)
# CLAUDE_CODE_API_KEY_HELPER_TTL_MS=300000

# Optional: override Claude Code config directory (default ~/.claude)
# CLAUDE_CONFIG_DIR=/path/to/claude-config

# Optional model override
# CLAUDE_MODEL=claude-sonnet-4-20250514
